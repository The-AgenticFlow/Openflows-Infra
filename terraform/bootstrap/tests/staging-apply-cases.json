{
  "identity_policies": [
    "rendered/admin.json",
    "rendered/staging-environment-isolation.json"
  ],
  "boundary_policies": [
    "rendered/boundary.json"
  ],
  "cases": [
    {
      "name": "upwards: cannot rewrite production apply role trust",
      "action": "iam:UpdateAssumeRolePolicy",
      "resource": "arn:aws:iam::686255958454:role/openflows/openflows-production-terraform-apply",
      "expect": "deny"
    },
    {
      "name": "upwards: cannot rewrite platform admin role trust",
      "action": "iam:UpdateAssumeRolePolicy",
      "resource": "arn:aws:iam::686255958454:role/openflows/openflows-platform-admin",
      "expect": "deny"
    },
    {
      "name": "upwards: cannot attach policies to its own role",
      "action": "iam:AttachRolePolicy",
      "resource": "arn:aws:iam::686255958454:role/openflows/openflows-staging-terraform-apply",
      "expect": "deny"
    },
    {
      "name": "upwards: cannot edit the boundary",
      "action": "iam:CreatePolicyVersion",
      "resource": "arn:aws:iam::686255958454:policy/openflows/openflows-permissions-boundary",
      "expect": "deny"
    },
    {
      "name": "upwards: cannot remove a role's boundary",
      "action": "iam:DeleteRolePermissionsBoundary",
      "resource": "arn:aws:iam::686255958454:role/openflows/staging/app",
      "expect": "deny"
    },
    {
      "name": "upwards: cannot touch the GitHub OIDC provider",
      "action": "iam:UpdateOpenIDConnectProviderThumbprint",
      "resource": "arn:aws:iam::686255958454:oidc-provider/token.actions.githubusercontent.com",
      "expect": "deny"
    },
    {
      "name": "must work: create role under /openflows/staging/ with boundary",
      "action": "iam:CreateRole",
      "resource": "arn:aws:iam::686255958454:role/openflows/staging/app",
      "expect": "allow",
      "context": {
        "iam:PermissionsBoundary": "arn:aws:iam::686255958454:policy/openflows/openflows-permissions-boundary",
        "aws:RequestTag/Environment": "staging"
      }
    },
    {
      "name": "upwards: cannot create a role without the boundary",
      "action": "iam:CreateRole",
      "resource": "arn:aws:iam::686255958454:role/openflows/staging/app",
      "expect": "deny"
    },
    {
      "name": "sideways: cannot create a role under /openflows/production/",
      "action": "iam:CreateRole",
      "resource": "arn:aws:iam::686255958454:role/openflows/production/app",
      "expect": "deny",
      "context": {
        "iam:PermissionsBoundary": "arn:aws:iam::686255958454:policy/openflows/openflows-permissions-boundary"
      }
    },
    {
      "name": "outwards: cannot reset another user's password",
      "action": "iam:UpdateLoginProfile",
      "resource": "arn:aws:iam::686255958454:user/someone",
      "expect": "deny"
    },
    {
      "name": "outwards: cannot deactivate another user's MFA",
      "action": "iam:DeactivateMFADevice",
      "resource": "arn:aws:iam::686255958454:user/someone",
      "expect": "deny"
    },
    {
      "name": "must work: create the EKS service-linked role",
