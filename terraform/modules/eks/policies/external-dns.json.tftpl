{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ChangeRecordsInTheEnvironmentZoneOnly",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets", "route53:ListResourceRecordSets"],
      "Resource": "${zone_arn}"
    },
    {
      "Sid": "FindTheZone",
      "Effect": "Allow",
      "Action": "route53:ListHostedZones",
      "Resource": "*"
    }
  ]
}
